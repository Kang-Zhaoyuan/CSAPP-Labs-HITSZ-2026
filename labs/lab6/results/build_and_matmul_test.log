========== Lab6 Build and Correctness Test ==========
========== 1. Build Baseline ==========
gcc -O3 -o run run.c -lm
gcc -O3 -o runq runq.c -lm
========== 2. Build AVX2 + OpenMP ==========
gcc -O3 -mavx2 -fopenmp -ffp-contract=off -DUSE_AVX2 -o run-opt run.c -lm
========== 3. Test Matrix Multiplication ==========
